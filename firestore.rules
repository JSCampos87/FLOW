rules_version = '2';
// Regras do Firestore para o FLOW (projeto pcv-ferramentas). Publicar na consola Firebase › Firestore › Regras.
// ATENÇÃO: substituem as regras atuais do projeto. As coleções das outras apps (PCV, PCM, Contador)
// mantêm o acesso que têm hoje (qualquer sessão, incluindo anónima) até migrarem para o login Microsoft.
service cloud.firestore {
  match /databases/{database}/documents {

    // Conta Microsoft da empresa (Entra ID). Acrescentar aqui os domínios do grupo.
    function empresa() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'microsoft.com'
        && request.auth.token.email.lower().matches('.*@(graphicsleader[.]pt|hinojosa[.](es|pt|com))$');
    }

    // ---------- FLOW (coleções flow_*) ----------
    // Registo de alterações: só se acrescenta, nunca se altera nem apaga.
    match /flow_auditoria/{id} {
      allow read, create: if empresa();
      allow update, delete: if false;
    }
    match /{col}/{id} {
      allow read, write: if col.matches('flow_.*') && col != 'flow_auditoria' && empresa();
    }

    // ---------- Outras apps (PCV, Auditorias PCM, Contador de Folhas) ----------
    // Mantém o comportamento atual (sessão anónima). Passar para empresa() quando migrarem.
    match /{col}/{id} {
      allow read, write: if !col.matches('flow_.*') && request.auth != null;
    }
  }
}
